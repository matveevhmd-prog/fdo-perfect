function ss_() {
  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  if (ss.getName() !== EXPECTED_NAME) throw new Error('Не той файл: ' + ss.getName());
  return ss;
}
function log_(m) { Logger.log(m); }

// ---------- ПЛАН ЗМІН (нічого не пише) ----------
function dryRun() {
  const ss = ss_();
  log_('=== DRY RUN: нічого не записується ===');
  const g = ss.getSheetByName('Графік_оплат');
  const a29 = g.getRange('A29').getValue();
  log_('Н-4: Графік_оплат!A29 зараз = ' + a29 + ' (тип ' + Object.prototype.toString.call(a29) + ') → буде текст "24-11", формат "Звичайний текст"');
  DEMO_TABS.forEach(function (t) {
    const s = ss.getSheetByName(t);
    const cur = s.getRange('U1:U4').getValues().map(function (r) { return r[0]; });
    const ok = cur[0] === 'ПроцентВиконання' && cur[1] === 'EV' && cur[2] === 'AC' && cur[3] === 'CPI';
    log_(t + ': U1:U4 зараз = ' + JSON.stringify(cur) + (ok ? ' → U1="Витрачено часу"; очистити U2:V2 і U4:V4; U3="Факт вартість"; V1 і V3 НЕ змінюються' : ' → ПРОПУСК (очікувані значення не збіглися)'));
  });
  log_('Вкладка ' + PKG_SHEET + ': ' + (ss.getSheetByName(PKG_SHEET) ? 'ВЖЕ ІСНУЄ — runAll зупиниться' : 'буде створена') + '; рядків пакетів = ' + PACKAGES.length);
  const per = {};
  PACKAGES.forEach(function (p) { per[p[0]] = (per[p[0]] || 0) + 1; });
  log_('Пакетів по проєктах: ' + JSON.stringify(per));
}

// ---------- ЗАПИС ----------
function runAll() {
  const ss = ss_();
  if (ss.getSheetByName(PKG_SHEET)) throw new Error('Вкладка ' + PKG_SHEET + ' вже існує — зупинка (захист від повторного запуску).');
  const stamp = Utilities.formatDate(new Date(), 'Europe/Kyiv', 'yyyy-MM-dd');
  const copy = DriveApp.getFileById(SPREADSHEET_ID).makeCopy(EXPECTED_NAME + '_bak_' + stamp);
  if (!copy || !copy.getId()) throw new Error('Бекап не створено — запис не починається.');
  log_('БЕКАП СТВОРЕНО. ID копії: ' + copy.getId());
  log_('Назва копії: ' + copy.getName());

  // Н-4
  const g = ss.getSheetByName('Графік_оплат');
  const a29 = g.getRange('A29');
  if (Object.prototype.toString.call(a29.getValue()) === '[object Date]' || String(a29.getValue()) === '24-11') {
    a29.setNumberFormat('@');
    a29.setValue('24-11');
    log_('Н-4: A29 = "' + a29.getValue() + '"');
  } else { log_('Н-4: ПРОПУСК, A29 = ' + a29.getValue()); }

  // Н-1, Н-2
  DEMO_TABS.forEach(function (t) {
    const s = ss.getSheetByName(t);
    const cur = s.getRange('U1:U4').getValues().map(function (r) { return r[0]; });
    if (cur[0] === 'ПроцентВиконання' && cur[1] === 'EV' && cur[2] === 'AC' && cur[3] === 'CPI') {
      s.getRange('U1').setValue('Витрачено часу');
      s.getRange('U2:V2').clearContent();
      s.getRange('U3').setValue('Факт вартість');
      s.getRange('U4:V4').clearContent();
      log_(t + ': Н-1, Н-2 виконано');
    } else { log_(t + ': ПРОПУСК Н-1/Н-2, U1:U4 = ' + JSON.stringify(cur)); }
  });

  // Вкладка EVM_пакети
  const sh = ss.insertSheet(PKG_SHEET);
  const n = PACKAGES.length;
  ['A','B','C','D','F','G','J','K'].forEach(function (c) { sh.getRange(c + '1:' + c + (n + 1)).setNumberFormat('@'); });
  sh.getRange(1, 1, 1, HEADER.length).setValues([HEADER]).setFontWeight('bold');
  PACKAGES.forEach(function (p, i) {
    const r = i + 2;
    sh.getRange(r, 1, 1, 4).setValues([[p[0], p[1], p[2], p[3]]]);
    const e = sh.getRange(r, 5);
    if (typeof p[4] === 'string' && p[4].charAt(0) === '=') e.setFormula(p[4]); else e.setValue(p[4]);
    sh.getRange(r, 6).setValue(p[5]);
    sh.getRange(r, 7).setValue('0/100');
    const d = p[6].split('-');
    sh.getRange(r, 9).setValue(new Date(Number(d[0]), Number(d[1]) - 1, Number(d[2]), 12, 0, 0));
    sh.getRange(r, 10).setValue(p[7]);
    sh.getRange(r, 11).setValue('demo');
  });
  sh.getRange(2, 5, n, 1).setNumberFormat('#,##0.00');
  sh.getRange(2, 8, n, 2).setNumberFormat('yyyy-mm-dd');
  sh.setFrozenRows(1);
  SpreadsheetApp.flush();
  log_('Вкладку ' + PKG_SHEET + ' створено, рядків: ' + n);
  verify();
}

// ---------- ПЕРЕВІРКА (читає назад) ----------
function verify() {
  const ss = ss_();
  const sh = ss.getSheetByName(PKG_SHEET);
  if (!sh) { log_('VERIFY: вкладки немає'); return; }
  const v = sh.getRange(2, 1, sh.getLastRow() - 1, 11).getValues();
  const sums = {}, cnt = {};
  v.forEach(function (r) { sums[r[0]] = (sums[r[0]] || 0) + Number(r[4]); cnt[r[0]] = (cnt[r[0]] || 0) + 1; });
  log_('V-а: рядків = ' + v.length + ' (очікується 100); по проєктах: ' + JSON.stringify(cnt));
  let ok = 0, total = 0;
  Object.keys(sums).forEach(function (pid) {
    const bac = BAC_BUREAU[pid] !== undefined ? BAC_BUREAU[pid] : ss.getSheetByName(pid).getRange('E7').getValue();
    const d = sums[pid] - bac;
    total++; if (Math.abs(d) <= 1) ok++;
    log_('V-б ' + pid + ': Σ=' + sums[pid].toFixed(2) + ' BAC=' + Number(bac).toFixed(2) + ' різниця=' + d.toFixed(2) + (Math.abs(d) <= 1 ? ' OK' : ' ПОМИЛКА'));
  });
  log_('V-б: ' + ok + ' з ' + total + ' проєктів у межах ±1 грн (очікується 14 з 14)');
  const empty = v.filter(function (r) { return !(r[8] instanceof Date); }).length;
  log_('V-в: рядків без планового фінішу = ' + empty + ' (очікується 0)');
  const bad = DEMO_TABS.filter(function (t) { return ss.getSheetByName(t).getRange('U1').getValue() !== 'Витрачено часу'; });
  log_('V-г: вкладок без "Витрачено часу" в U1 = ' + bad.length + ' (очікується 0)');
  log_('V-г: DEMO-01!V1 = ' + ss.getSheetByName('DEMO-01').getRange('V1').getValue() + ' (очікується 0,2416 — без змін)');
  const s1 = ss.getSheetByName('DEMO-01');
  log_('V-д: U2,U4 = "' + s1.getRange('U2').getValue() + '","' + s1.getRange('U4').getValue() + '" (порожні); U3 = "' + s1.getRange('U3').getValue() + '"; V3 = ' + s1.getRange('V3').getValue() + ' (очікується 149665,92)');
  const a29 = ss.getSheetByName('Графік_оплат').getRange('A29');
  log_('V-е: A29 = "' + a29.getValue() + '" тип ' + Object.prototype.toString.call(a29.getValue()) + ' (очікується текст 24-11)');
}
